# Copy this file to ".env" to change settings. All values are optional.

# Port for the web app (default 4600; the next free port is used if it is busy)
PORT=4600

# Where uploaded files (course media, attachments, the navigation video) are kept.
# Default: the "uploads" folder. On a host, point this at a persistent disk.
# UPLOAD_DIR=

# Signs sign-in tokens. If unset, a random one is created in data/secret.key.
# AUTH_SECRET=

# Optional: AI for the study coach, rubric score suggestions, and translating video captions into
# languages YouTube cannot translate. Without a key the coach answers from course material only. Use ONE.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_MODEL=

# Passwords for the starter accounts, used only when the data file is first created.
# 12+ characters with upper and lower case, a number, and a symbol. Avoid # and $ (or quote the value).
# In production, if unset, random passwords are written once to data/initial-credentials.txt.
# SEED_INSTRUCTOR_PASSWORD=
# SEED_LEARNER_PASSWORD=

# Set to 1 behind a reverse proxy (Render, nginx) so sign-in limits see real visitor addresses.
# TRUST_PROXY=1

# ---------------- Payments ----------------
# A PAID course opens only after the payment gateway confirms the payment. Set the keys of ONE gateway.
# Without any, learners cannot buy paid courses (they are told to contact their instructor);
# free courses and instructor-granted access still work.
#
# Razorpay (India: UPI, cards, netbanking, wallets). Keys: Razorpay Dashboard -> Account & Settings -> API Keys.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook (recommended): Dashboard -> Webhooks -> URL https://YOUR-SITE/api/payments/webhook/razorpay,
# events "payment.captured" and "order.paid". Put the webhook secret here:
# RAZORPAY_WEBHOOK_SECRET=
#
# Stripe (international cards, Apple Pay, Google Pay). Key: Stripe Dashboard -> Developers -> API keys.
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Webhook (recommended): URL https://YOUR-SITE/api/payments/webhook/stripe, events
# "checkout.session.completed", "checkout.session.async_payment_succeeded", "checkout.session.async_payment_failed".
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
#
# If both gateways are set, choose one: razorpay or stripe
# PAYMENT_PROVIDER=
# The currency course prices are charged in (the price you type in Course details is in this currency).
# Razorpay charges USD only if "International payments" is enabled on your account; otherwise use INR.
# PAYMENT_CURRENCY=USD
# Highest allowed course price (default: under 50 for USD, no limit for other currencies).
# MAX_COURSE_PRICE=
# Your site's public address, used for Stripe's return page (strongly recommended on a host):
# PUBLIC_URL=https://lms.example.com

# ---------------- Video transcripts ----------------
# Transcripts are the video's own captions. YouTube captions work with no key.
# Vimeo captions need a Vimeo access token with the "private" scope (developer.vimeo.com -> My Apps).
# VIMEO_ACCESS_TOKEN=
# Translation for languages YouTube cannot translate (and for Vimeo / uploaded videos) uses
# ANTHROPIC_API_KEY or GEMINI_API_KEY above, or Google Cloud Translation:
# GOOGLE_TRANSLATE_API_KEY=

# Optional: route AI calls through a gateway or proxy.
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# ---------------- Hosting ----------------
# Keep the database and uploads outside the app folder, so updating the app never touches them.
# DATA_DIR=/var/lib/usaii-lms/data
# UPLOAD_DIR=/var/lib/usaii-lms/uploads

# ---------------- Accounts and email ----------------
# Learners can create their own accounts (default). Set false so only instructors create accounts.
# ALLOW_SIGNUP=true
# "Forgot password?" emails. With a Hostinger mailbox:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=
# MAIL_FROM=USAII <no-reply@yourdomain.com>
# Local testing only: write emails to data/outbox.jsonl instead of sending them.
# MAIL_OUTBOX=1

# ---------------- PayPal (or use the Payment Settings screen) ----------------
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
